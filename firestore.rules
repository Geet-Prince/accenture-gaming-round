rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userDocId} (Candidate's Gmail username or Auth UID)
    // Fields:
    //   - uid: string (required, immutable) - Must match request.auth.uid
    //   - username: string (optional, string <= 100) - Candidate Gmail username
    //   - email: string (optional, string <= 100) - Candidate email address
    //   - displayName: string (optional, string <= 100) - Candidate display name
    //   - photoURL: string (optional, string <= 1000) - Profile avatar URL
    //   - lastLoginAt: timestamp (optional) - Server timestamp when user logged in
    //   - lastSyncedAt: string (optional, string <= 50) - ISO 8601 timestamp string
    //   - progress: map (optional) - Solved levels, high scores, accuracy, attempts
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function uidUnchanged() {
      return 'uid' in request.resource.data &&
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidOptionalString(field, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() <= maxLen);
    }

    // Domain Validator: User Document
    function isValidUserDoc(data) {
      return hasOnlyAllowedFields(['uid', 'username', 'email', 'displayName', 'photoURL', 'lastLoginAt', 'lastSyncedAt', 'progress']) &&
        ('uid' in data && data.uid is string && data.uid == request.auth.uid) &&
        isValidOptionalString('username', 100) &&
        isValidOptionalString('email', 100) &&
        isValidOptionalString('displayName', 100) &&
        isValidOptionalString('photoURL', 1000) &&
        isValidOptionalString('lastSyncedAt', 50) &&
        (!('lastLoginAt' in data) || data.lastLoginAt is timestamp) &&
        (!('progress' in data) || data.progress is map);
    }

    // User profile and game progress (keyed by Gmail username or Auth UID)
    match /users/{userDocId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userDocId ||
        (resource != null && resource.data.uid == request.auth.uid)
      );

      allow create: if isAuthenticated() &&
        uidUnchanged() &&
        isValidUserDoc(request.resource.data);

      allow update: if isAuthenticated() &&
        (request.auth.uid == userDocId || (resource != null && resource.data.uid == request.auth.uid)) &&
        uidNotModified() &&
        isValidUserDoc(request.resource.data);

      allow delete: if isAuthenticated() &&
        (request.auth.uid == userDocId || (resource != null && resource.data.uid == request.auth.uid));
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
