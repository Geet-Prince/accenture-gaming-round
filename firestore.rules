rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Collection: users
    // Document ID: {uid}  ← always the Firebase Auth UID
    //
    // Fields stored in the document:
    //   uid         : string  (required) – must equal request.auth.uid
    //   username    : string  (optional) – Gmail username part (display only)
    //   email       : string  (optional)
    //   displayName : string  (optional)
    //   photoURL    : string  (optional)
    //   createdAt   : string | timestamp (optional)
    //   lastLoginAt : string | timestamp (optional)
    //   lastSyncedAt: string  (optional)
    //   progress    : map     (optional)
    // ===============================================================

    // --- Helpers ---------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isValidOptionalString(field, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() <= maxLen);
    }

    function isValidUserPayload() {
      let d = request.resource.data;
      // Document must contain only known fields
      return d.keys().hasOnly([
            'uid', 'username', 'email', 'displayName', 'photoURL',
            'createdAt', 'lastLoginAt', 'lastSyncedAt', 'progress'
          ]) &&
        // uid field must match the authenticated user
        ('uid' in d && d.uid is string && d.uid == request.auth.uid) &&
        isValidOptionalString('username',     100) &&
        isValidOptionalString('email',        100) &&
        isValidOptionalString('displayName',  100) &&
        isValidOptionalString('photoURL',    1000) &&
        isValidOptionalString('lastSyncedAt',  50) &&
        (!('createdAt'   in d) || d.createdAt   is string || d.createdAt   is timestamp) &&
        (!('lastLoginAt' in d) || d.lastLoginAt is string || d.lastLoginAt is timestamp) &&
        (!('progress'    in d) || d.progress    is map);
    }

    // --- User documents (doc ID = uid) ----------------------------
    match /users/{uid} {

      // Any signed-in user can read their own document
      allow read: if isSignedIn() && isOwner(uid);

      // Create: only the owner, payload must be valid
      allow create: if isSignedIn() && isOwner(uid) && isValidUserPayload();

      // Update: only the owner, uid field must not change, payload must be valid
      allow update: if isSignedIn() && isOwner(uid) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid) &&
        isValidUserPayload();

      // Delete: only the owner
      allow delete: if isSignedIn() && isOwner(uid);
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
