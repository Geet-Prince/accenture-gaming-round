rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches Firebase Auth UID)
    // Fields:
    //   - uid: string (required, immutable) - Must match request.auth.uid
    //   - email: string (optional, string <= 100) - Candidate email address
    //   - displayName: string (optional, string <= 100) - Candidate display name
    //   - photoURL: string (optional, string <= 1000) - Profile avatar URL
    //   - lastLoginAt: timestamp (optional) - Server timestamp when user logged in
    //   - lastSyncedAt: string (optional, string <= 50) - ISO 8601 timestamp string
    //   - progress: map (optional) - Solved levels, high scores, accuracy, attempts
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidOptionalString(field, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() <= maxLen);
    }

    // Domain Validator: User Document
    function isValidUserDoc(data) {
      return hasOnlyAllowedFields(['uid', 'email', 'displayName', 'photoURL', 'lastLoginAt', 'lastSyncedAt', 'progress']) &&
        ('uid' in data && data.uid is string && data.uid == request.auth.uid) &&
        isValidOptionalString('email', 100) &&
        isValidOptionalString('displayName', 100) &&
        isValidOptionalString('photoURL', 1000) &&
        isValidOptionalString('lastSyncedAt', 50) &&
        (!('lastLoginAt' in data) || data.lastLoginAt is timestamp) &&
        (!('progress' in data) || data.progress is map);
    }

    // User profile and game progress
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged() && isValidUserDoc(request.resource.data);
      allow update: if isOwner(userId) && uidNotModified() && isValidUserDoc(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
